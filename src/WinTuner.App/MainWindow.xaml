<Window
    x:Class="WinTuner.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinTuner.App">

    <Grid>
        <NavigationView x:Name="NavView"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="248"
                        PaneTitle="WinTuner"
                        SelectionChanged="OnNavSelectionChanged">
            <Grid Padding="28,18,28,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="CategoryTitle"
                           Grid.Row="0"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Margin="0,0,0,2" />

                <TextBlock x:Name="SubtitleText"
                           Grid.Row="1"
                           FontSize="13"
                           Opacity="0.7"
                           Margin="0,0,0,14"
                           TextWrapping="Wrap"
                           Text="Toggle to apply or revert. Every change writes a citable registry value you can reset anytime." />

                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <InfoBar x:Name="StatusBar"
                             Grid.Column="0"
                             Margin="0,0,12,0"
                             IsOpen="False" />
                    <Button x:Name="ApplyAllButton"
                            Grid.Column="1"
                            Click="OnApplyAll"
                            Margin="0,0,8,0"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8FB;" />
                            <TextBlock Text="Apply all" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ResetAllButton"
                            Grid.Column="2"
                            Click="OnResetAll"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" />
                            <TextBlock Text="Reset all" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RefreshButton"
                            Grid.Column="3"
                            Click="OnRefresh"
                            Margin="0,0,8,0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <AutoSuggestBox x:Name="SearchBox"
                                   Grid.Column="4"
                                   Width="240"
                                   PlaceholderText="Search tweaks"
                                   QueryIcon="Find"
                                   TextChanged="OnSearchTextChanged" />
                </Grid>

                <InfoBar x:Name="RestartBar"
                         Grid.Row="3"
                         Margin="0,0,0,14"
                         IsOpen="False"
                         Severity="Warning"
                         Title="A restart is required"
                         Message="Some tweaks you applied will not take full effect until you restart Windows.">
                    <InfoBar.ActionButton>
                        <Button Content="Restart now" Click="OnRestartNow" Style="{StaticResource AccentButtonStyle}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <ContentControl x:Name="ContentArea"
                                Grid.Row="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater x:Name="TweakList">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:TweakViewModel">
                                <Border Margin="0,0,0,14"
                                        HorizontalAlignment="Stretch"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="18">
                                    <Grid ColumnDefinitions="*,Auto"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{x:Bind Title}"
                                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                                      IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                                      Toggled="OnToggle"
                                                      VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{x:Bind StateText}"
                                                   FontSize="12" Opacity="0.7"
                                                   Margin="0,4,0,10" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{x:Bind Description}"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   Margin="0,0,0,10" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{x:Bind Reference}"
                                                   FontFamily="Consolas"
                                                   FontSize="12" Opacity="0.7"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True"
                                                   Margin="0,0,0,12" />
                                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                                    Orientation="Horizontal"
                                                    Spacing="14">
                                            <Button Content="Reset to default"
                                                    Click="OnReset"
                                                    Style="{StaticResource AccentButtonStyle}" />
                                            <TextBlock Text="Requires administrator"
                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                       Visibility="{x:Bind ElevationVisibility}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="Restart required"
                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                       Visibility="{x:Bind RebootVisibility}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </ContentControl>
            </Grid>
        </NavigationView>

        <!-- Administrator elevation modal: blocks the app until it is relaunched elevated. -->
        <Border x:Name="AdminOverlay"
                Background="{ThemeResource SystemControlChromeHighAcrylicWindowMediumBrush}"
                Visibility="Collapsed">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="32"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <FontIcon Glyph="&#xE7EF;" FontSize="40" HorizontalAlignment="Center" />
                    <TextBlock Text="Administrator privileges required"
                               Style="{StaticResource TitleTextBlockStyle}"
                               TextAlignment="Center" />
                    <TextBlock Text="WinTuner writes to HKEY_LOCAL_MACHINE for many system tweaks. Relaunch WinTuner as administrator so every tweak can be applied and reverted."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Opacity="0.8" />
                    <Button Content="Restart as administrator"
                            Click="OnRelaunchAdmin"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" />
                    <Button Content="Exit"
                            Click="OnExit"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
