<Window
    x:Class="WinTuner.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WinTuner.Core.Tweaks"
    Title="WinTuner">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListView x:Name="CategoryList"
                  Grid.Column="0"
                  SelectionChanged="OnCategorySelected" />

        <ListView x:Name="TweakList"
                  Grid.Column="1"
                  SelectionChanged="OnTweakSelected">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:RegistryTweak">
                    <StackPanel Margin="8">
                        <TextBlock Text="{x:Bind Title}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Id}"
                                   FontSize="11"
                                   Opacity="0.6" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ScrollViewer Grid.Column="2" Padding="24">
            <StackPanel Spacing="12">
                <TextBlock x:Name="TitleText"
                           Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="DescText"
                           TextWrapping="Wrap"
                           Style="{StaticResource BodyTextBlockStyle}" />
                <TextBlock x:Name="RefText"
                           FontSize="11"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="StateText"
                           FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="ApplyBtn" Content="Apply" Click="OnApply" />
                    <Button x:Name="RevertBtn" Content="Revert" Click="OnRevert" />
                    <Button x:Name="ResetBtn" Content="Reset to default" Click="OnReset" />
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           Foreground="{StaticResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
