<Window
    x:Class="WinTuner.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinTuner.App">

    <Grid>
        <NavigationView x:Name="NavView"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="240"
                        PaneTitle="WinTuner"
                        SelectionChanged="OnNavSelectionChanged">

            <NavigationView.PaneFooter>
                <StackPanel Padding="12,8" Spacing="8">
                    <Button x:Name="AdminButton"
                            Click="OnRelaunchAdmin"
                            HorizontalAlignment="Stretch"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7EF;" />
                            <TextBlock Text="Restart as administrator" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ImportButton"
                            Click="OnImport"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B6;" />
                            <TextBlock Text="Import profile" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportButton"
                            Click="OnExport"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" />
                            <TextBlock Text="Export profile" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid Padding="28,18,28,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="CategoryTitle"
                           Grid.Row="0"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Margin="0,0,0,2" />

                <TextBlock x:Name="SubtitleText"
                           Grid.Row="1"
                           FontSize="13"
                           Opacity="0.7"
                           Margin="0,0,0,14"
                           TextWrapping="Wrap"
                           Text="Toggle to apply or revert. Every change writes a citable registry value you can reset anytime." />

                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <InfoBar x:Name="StatusBar"
                             Grid.Column="0"
                             Margin="0,0,12,0"
                             IsOpen="False" />
                    <Button x:Name="ApplyAllButton"
                            Grid.Column="1"
                            Click="OnApplyAll"
                            Margin="0,0,8,0"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8FB;" />
                            <TextBlock Text="Apply all" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ResetAllButton"
                            Grid.Column="2"
                            Click="OnResetAll"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE777;" />
                            <TextBlock Text="Reset all" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RefreshButton"
                            Grid.Column="3"
                            Click="OnRefresh"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </Grid>

                <InfoBar x:Name="AdminBanner"
                         Grid.Row="3"
                         Margin="0,0,0,14"
                         IsOpen="False"
                         Severity="Warning"
                         Title="Some tweaks need administrator rights"
                         Message="HKLM tweaks will fail until you relaunch as administrator.">
                    <InfoBar.ActionButton>
                        <Button Content="Restart as administrator" Click="OnRelaunchAdmin" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <ContentControl x:Name="ContentArea"
                                Grid.Row="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater x:Name="TweakList">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:TweakViewModel">
                                <Border Margin="0,0,0,14"
                                        HorizontalAlignment="Stretch"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="18">
                                    <Grid ColumnDefinitions="*,Auto"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{x:Bind Title}"
                                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <ToggleSwitch Grid.Row="0" Grid.Column="1"
                                                      IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                                      Toggled="OnToggle"
                                                      VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{x:Bind StateText}"
                                                   FontSize="12" Opacity="0.7"
                                                   Margin="0,4,0,10" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{x:Bind Description}"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   Margin="0,0,0,10" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{x:Bind Reference}"
                                                   FontFamily="Consolas"
                                                   FontSize="12" Opacity="0.7"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True"
                                                   Margin="0,0,0,12" />
                                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                                    Orientation="Horizontal"
                                                    Spacing="14">
                                            <Button Content="Reset to default"
                                                    Click="OnReset"
                                                    Style="{StaticResource AccentButtonStyle}" />
                                            <TextBlock Text="Requires administrator"
                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                       Visibility="{x:Bind ElevationVisibility}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="Restart required"
                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                       Visibility="{x:Bind RebootVisibility}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </ContentControl>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
